#!/usr/bin/env bash
set -eu

notes="$*"
version=$(bundle exec ruby -Ilib -rsolid_dashboard -e 'print SolidDashboard::VERSION')
prerelease=$(ruby -rrubygems -e 'puts Gem::Version.new(ARGV.fetch(0)).prerelease?' "$version")

flags=()
if [ "$prerelease" = "true" ]; then
  flags+=(--prerelease)
fi
if [ -n "$notes" ]; then
  flags+=(--notes "$notes")
fi
npm ci
npm run build
gem build solid_dashboard.gemspec
git tag -a "v$version" -m "Release $version"
git push origin "v$version"
gh release create "v$version" \
                  "solid_dashboard-$version.gem" \
                  --verify-tag \
                  --title "$version" \
                  --generate-notes "${flags[@]}"
gem push "solid_dashboard-$version.gem" --host https://rubygems.org
