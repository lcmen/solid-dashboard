<div class="flex items-center justify-between gap-4">
  <h1 class="h2 min-w-0 tracking-tight">
    <%= title %>
  </h1>

  <div class="flex shrink-0 items-center gap-2">
    <% unless content_for?(:hide_refresh) %>
      <%= link_to request.fullpath, class: "btn btn-secondary" do %>
        <svg
          aria-hidden="true"
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M20 11a8 8 0 0 0-14-5L3 9m0-6v6h6M4 13a8 8 0 0 0 14 5l3-3m0 6v-6h-6"
          />
        </svg>
        Refresh
      <% end %>
    <% end %>

    <%= render "layouts/solid_dashboard/mobile_menu" %>
  </div>
</div>

<p class="text-secondary-500 mt-2 mb-6"><%= description %></p>
