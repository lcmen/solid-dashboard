<% content_for :title, "Cache entries" %>

<p class="text-secondary-500 mt-2 mb-6">
  Current entries stored in Solid Cache.
</p>

<dl class="card-group mb-6 flex-wrap" aria-label="Summary">
  <div class="card-group-item basis-32">
    <dt class="text-secondary-500 text-xs">Stored entries</dt>
    <dd class="h3 mt-1">0</dd>
  </div>

  <div class="card-group-item basis-32">
    <dt class="text-secondary-500 text-xs">Stored size</dt>
    <dd class="h3 mt-1">0 MB</dd>
  </div>
</dl>

<section
  class="card border-secondary-200 border shadow-none"
  aria-labelledby="entries-heading"
>
  <div class="flex-between border-secondary-100 gap-4 border-b px-5 py-4">
    <h2 id="entries-heading" class="h6">Stored cache keys</h2>
  </div>

  <div class="table-wrapper">
    <table
      class="table border-0 whitespace-nowrap"
      aria-labelledby="entries-heading"
    >
      <thead>
        <tr>
          <th scope="col">Cache key</th>
          <th scope="col">Size</th>
          <th scope="col">Created</th>
          <th scope="col">Expires</th>
          <th scope="col">Status</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>

      <tbody>
        <tr>
          <td colspan="6" class="text-secondary-500 text-center">
            No cache entries
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</section>
