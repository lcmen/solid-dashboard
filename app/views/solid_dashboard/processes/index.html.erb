<% content_for :title, "Processes" %>

<p class="text-secondary-500 mt-2 mb-6">
  Worker, dispatcher, scheduler, and supervisor processes.
</p>

<dl class="card-group mb-6 flex-wrap" aria-label="Summary">
  <div class="card-group-item basis-32">
    <dt class="text-secondary-500 text-xs">Processes</dt>
    <dd class="h3 mt-1">0</dd>
  </div>

  <div class="card-group-item basis-32">
    <dt class="text-secondary-500 text-xs">Workers</dt>
    <dd class="h3 mt-1">0</dd>
  </div>

  <div class="card-group-item basis-32">
    <dt class="text-secondary-500 text-xs">Dispatchers</dt>
    <dd class="h3 mt-1">0</dd>
  </div>

  <div class="card-group-item basis-32">
    <dt class="text-secondary-500 text-xs">Stale heartbeat</dt>
    <dd class="h3 mt-1">0</dd>
  </div>
</dl>

<section
  class="card border-secondary-200 border shadow-none"
  aria-labelledby="processes-heading"
>
  <div class="flex-between border-secondary-100 gap-4 border-b px-5 py-4">
    <h2 id="processes-heading" class="h6">Registered processes</h2>
  </div>

  <div class="table-wrapper">
    <table
      class="table border-0 whitespace-nowrap"
      aria-labelledby="processes-heading"
    >
      <thead>
        <tr>
          <th scope="col">Process</th>
          <th scope="col">Kind</th>
          <th scope="col">Hostname</th>
          <th scope="col">PID</th>
          <th scope="col">Last heartbeat</th>
          <th scope="col">Status</th>
        </tr>
      </thead>

      <tbody>
        <tr>
          <td colspan="6" class="text-secondary-500 text-center">
            No processes
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</section>
