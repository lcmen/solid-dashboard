<aside
  id="dashboard-sidebar"
  class="sidebar"
  x-on:click.outside="open = false"
  x-bind:class="{ 'is-open': open }"
>
  <div class="navbar-brand mx-2 mb-6">
    <span aria-hidden="true" class="navbar-brand-icon">S</span>
    <span class="h6">Solid Dashboard</span>
  </div>

  <nav aria-label="Dashboard">
    <ul class="space-y-4">
      <% navigation.each do |group| %>
        <li>
          <h2 class="h6 nav-caption text-xs">
            <%= group[:title] %>
          </h2>

          <ul class="space-y-1">
            <% group[:links].each do |link| %>
              <li>
                <%= link_to link[:label], link[:path],
                aria: { current: link[:active] ? "page" : nil },
                class: "nav-link" %>
              </li>
            <% end %>
          </ul>
        </li>
      <% end %>
    </ul>
  </nav>
</aside>
